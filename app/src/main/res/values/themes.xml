<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AuraView" parent="Theme.Material3.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Leanback theme for Android TV -->
    <style name="Theme.AuraView.Leanback" parent="Theme.Leanback">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="defaultSearchBrightColor">@color/primary</item>
        <item name="defaultSearchColor">@color/primary_dark</item>
    </style>

    <!-- Card styles for TV interface -->
    <style name="AuraViewCard">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">4dp</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <!-- Button styles for TV -->
    <style name="AuraViewButton" parent="android:style/Widget.Material.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/btn_primary</item>
    </style>

    <!-- Text styles -->
    <style name="AuraViewTitle" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AuraViewSubtitle" parent="android:style/TextAppearance.Material.Subhead">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="AuraViewBody" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
